rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Busca os dados da campanha no Firestore
    function getCampaignData(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }
    
    // Helper: Verifica se o usuário é o dono da campanha (Mestre)
    function isCampaignOwner(campaignId) {
      let camp = getCampaignData(campaignId);
      return isAuthenticated() && ('ownerId' in camp) && camp.ownerId == request.auth.uid;
    }
    
    // Helper: Verifica se o usuário é membro da campanha (Mestre ou Colaborador)
    function isCampaignMember(campaignId) {
      let camp = getCampaignData(campaignId);
      return isAuthenticated() && (
        (('ownerId' in camp) && camp.ownerId == request.auth.uid) || 
        (('collaborators' in camp) && (camp.collaborators is list) && (request.auth.uid in camp.collaborators))
      );
    }

    // Helper: Verifica se o usuário logado está na lista de atribuídos do item
    function isAssigned(resourceData) {
      return isAuthenticated() && 
        ('assignedTo' in resourceData) && 
        (resourceData.assignedTo is list) && 
        (request.auth.uid in resourceData.assignedTo);
    }

    // Helper: Verifica se o campo assignedTo não foi modificado
    function assignedToNotModified() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo']);
    }

    // Helper: Valida criação de entidade (apenas o Mestre pode pré-atribuir jogadores)
    function canCreateEntity(campaignId) {
      return isCampaignMember(campaignId) && (
        isCampaignOwner(campaignId) ||
        !('assignedTo' in request.resource.data) ||
        request.resource.data.assignedTo == [] ||
        request.resource.data.assignedTo == null
      );
    }

    // Regras para Perfis de Usuários
    match /users/{userId} {
      // Qualquer usuário autenticado pode ler os perfis para buscar outros por e-mail/ID
      allow read: if isAuthenticated();
      // Apenas o próprio dono do perfil pode editar seus dados
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Subcoleção de notas pessoais (para cada personagem)
      match /personal_notes/{charId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Regras para Campanhas
    match /campaigns/{campaignId} {
      // Leitura permitida para Mestre ou Jogadores da campanha
      allow read: if isAuthenticated() && (
        (('ownerId' in resource.data) && resource.data.ownerId == request.auth.uid) || 
        (('collaborators' in resource.data) && (resource.data.collaborators is list) && (request.auth.uid in resource.data.collaborators))
      );
      
      // Criação permitida para qualquer usuário autenticado
      allow create: if isAuthenticated();
      
      // Modificação ou Exclusão permitida apenas para o dono (Mestre) da campanha
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Subcoleção: Diários (Entries)
      match /entries/{entryId} {
        // Leitura: Mestre lê tudo. Jogador lê se compartilhado, se for autor ou se estiver atribuído.
        allow read: if isCampaignMember(campaignId) && (
          resource.data.shared == true || 
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId) ||
          isAssigned(resource.data)
        );
        // Criação: Qualquer membro da campanha
        allow create: if canCreateEntity(campaignId);
        // Atualização: Mestre, autor ou jogador atribuído (este sem alterar assignedTo)
        allow update: if isCampaignMember(campaignId) && (
          isCampaignOwner(campaignId) ||
          (
            (resource.data.authorId == request.auth.uid || isAssigned(resource.data)) &&
            assignedToNotModified()
          )
        );
        // Exclusão: Apenas o autor original ou o Mestre
        allow delete: if isCampaignMember(campaignId) && (
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId)
        );
      }

      // Subcoleção: Personagens (Characters)
      match /characters/{charId} {
        // Leitura: Mestre lê tudo. Jogador lê se compartilhado, se for autor ou se estiver atribuído.
        allow read: if isCampaignMember(campaignId) && (
          resource.data.shared == true || 
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId) ||
          isAssigned(resource.data)
        );
        // Criação: Qualquer membro da campanha
        allow create: if canCreateEntity(campaignId);
        // Atualização: Mestre, autor ou jogador atribuído (este sem alterar assignedTo)
        allow update: if isCampaignMember(campaignId) && (
          isCampaignOwner(campaignId) ||
          (
            (resource.data.authorId == request.auth.uid || isAssigned(resource.data)) &&
            assignedToNotModified()
          )
        );
        // Exclusão: Apenas o autor original ou o Mestre
        allow delete: if isCampaignMember(campaignId) && (
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId)
        );
      }

      // Subcoleção: Lugares (Locations)
      match /locations/{locId} {
        // Leitura: Mestre lê tudo. Jogador lê se compartilhado, se for autor ou se estiver atribuído.
        allow read: if isCampaignMember(campaignId) && (
          resource.data.shared == true || 
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId) ||
          isAssigned(resource.data)
        );
        // Criação: Qualquer membro da campanha
        allow create: if canCreateEntity(campaignId);
        // Atualização: Mestre, autor ou jogador atribuído (este sem alterar assignedTo)
        allow update: if isCampaignMember(campaignId) && (
          isCampaignOwner(campaignId) ||
          (
            (resource.data.authorId == request.auth.uid || isAssigned(resource.data)) &&
            assignedToNotModified()
          )
        );
        // Exclusão: Apenas o autor original ou o Mestre
        allow delete: if isCampaignMember(campaignId) && (
          resource.data.authorId == request.auth.uid ||
          isCampaignOwner(campaignId)
        );
      }
    }
  }
}
